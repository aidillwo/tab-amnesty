{
  "manifest_version": 3,
  "name": "Tab Amnesty",
  "version": "0.1.0",
  "description": "Resolve tab overload: cluster your open tabs, extract what matters into one note, and close them guilt-free.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>", "https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Amnesty — triage your tabs"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
